# Story 17.1 (T17.1.3): copy this file to .env (already git-ignored, see .gitignore) and fill in
# real values before running `docker compose up`. Nothing in this example file is a real secret —
# see docs/DEPLOYMENT.md for the full deploy walkthrough and docs/EPIC_BREAKDOWN.md's Epic 16.2
# note for the secrets audit this project already went through.

# SQL Server 'sa' password inside the db container. Must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit+symbol).
DB_SA_PASSWORD=

# Overrides the committed appsettings.json placeholder (server/src/CrowdCoffee.Api/appsettings.json)
# — that value is documented there as local-dev-only and must be rotated before go-live. Generate
# a real one with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Origin the SPA is actually served from — becomes Cors:AllowedOrigins[0] (server-side) and
# Paymob's PublicFrontendBaseUrl (return-URL construction). http://localhost:8080 matches this
# compose file's default frontend port mapping.
FRONTEND_ORIGIN=http://localhost:8080

# Origin the API is reachable at from a client's own browser (Paymob's PublicApiBaseUrl — it's
# what a customer's browser is redirected back to after paying).
PUBLIC_API_BASE_URL=http://localhost:5076

# Epic 10: no live Paymob credentials exist for this project yet (see EPIC_BREAKDOWN.md's Epic 10
# note) — leave these blank for local/staging use; InitiatePaymentHandler fails fast with
# Payment.NotConfigured rather than calling Paymob with blank credentials. Fill in before
# accepting real card/wallet payments.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ASPNETCORE_ENVIRONMENT=Production is docker-compose.yml's default (Swagger UI off, HSTS on,
# CSP header on) — override to Development only for local troubleshooting, never for a real
# deploy.
ASPNETCORE_ENVIRONMENT=Production
